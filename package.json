{
  "name": "securlab",
  "version": "0.1.0",
  "description": "Minecraft server security testing lab for authorized penetration testing and vulnerability detection",
  "main": "./out/main/index.js",
  "author": "Verlintas",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lab:smoke": "esbuild scripts/lab-smoke.ts --bundle --platform=node --format=esm --packages=external --outfile=out/smoke.mjs && node out/smoke.mjs",
    "engine:smoke": "esbuild scripts/engine-smoke.ts --bundle --platform=node --format=esm --packages=external --outfile=out/engine-smoke.mjs && node out/engine-smoke.mjs",
    "recon:smoke": "esbuild scripts/recon-smoke.ts --bundle --platform=node --format=esm --packages=external --outfile=out/recon-smoke.mjs && node out/recon-smoke.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "i18next": "^26.4.3",
    "lucide-react": "^1.55.0",
    "minecraft-protocol": "^1.68.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  },
  "allowScripts": {
    "electron@44.7.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
